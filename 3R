<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Editor — Mapa interactivo</title>
<style>
*{box-sizing:border-box}
body{margin:0;background:#f1f3f2;color:#222;font-family:Arial,Helvetica,sans-serif}
header{position:sticky;top:0;z-index:30;background:#fff;border-bottom:1px solid #ddd;padding:13px 18px;display:flex;align-items:center;justify-content:space-between;gap:15px}
h1{margin:0;font-size:19px} header small{color:#777}
.actions{display:flex;gap:7px;flex-wrap:wrap}
button{border:0;border-radius:8px;padding:9px 12px;font-weight:700;cursor:pointer}
.primary{background:#159447;color:#fff} .secondary{background:#e8ecea} .danger{background:#d64a4a;color:#fff}
.layout{display:grid;grid-template-columns:minmax(0,1fr) 340px;gap:16px;padding:16px;max-width:1700px;margin:auto}
.stage{background:#fff;padding:10px;border-radius:13px;box-shadow:0 5px 20px #00000012}
.map{position:relative;line-height:0;overflow:hidden;cursor:crosshair}
.map img{display:block;width:100%;height:auto}
.hotspot{position:absolute;transform:translate(-50%,-50%);background:transparent;border:1px solid transparent;cursor:pointer;z-index:5}
.hotspot:hover,.hotspot.selected{background:rgba(21,148,71,.10);border:1px dashed rgba(21,148,71,.45)}
.hotspot::after{content:"";position:absolute;inset:0}
.panel{background:#fff;border-radius:13px;padding:15px;box-shadow:0 5px 20px #00000012;height:max-content;position:sticky;top:78px}
.panel h2{font-size:18px;margin:0 0 12px}
label{display:block;font-size:12px;font-weight:800;color:#444;margin:10px 0 5px}
input,textarea{width:100%;border:1px solid #ccd2cf;border-radius:8px;padding:9px;font:inherit;font-size:13px}
textarea{min-height:68px;resize:vertical}
.row{display:flex;gap:7px;margin-top:11px} .row button{flex:1}
.note{font-size:11px;color:#777;line-height:1.4;margin-top:10px}
.list{border-top:1px solid #eee;margin-top:14px;padding-top:12px}
.item{padding:8px;border-bottom:1px solid #eee;font-size:12px;cursor:pointer}
.item:hover{background:#f4f7f5}
.preview{position:absolute;z-index:20;width:280px;background:white;border-radius:13px;padding:14px;box-shadow:0 10px 30px #0005;border-top:5px solid #159447;display:none;line-height:1.35}
.preview.show{display:block}
.preview h3{margin:0 0 6px;font-size:17px} .preview p{font-size:12px;color:#555;margin:5px 0}
.preview img{width:100%;max-height:130px;object-fit:cover;border-radius:8px;margin-top:7px}
@media(max-width:900px){.layout{grid-template-columns:1fr}.panel{position:static}}
</style>
</head>
<body>
<header>
<div><h1>Editor de mapa interactivo</h1><small>Mapa original de la Red Territorial de Reciclaje</small></div>
<div class="actions">
<button class="secondary" onclick="addPoint()">＋ Agregar zona transparente</button>
<button class="secondary" onclick="exportData()">Exportar</button>
<button class="secondary" onclick="importData()">Importar</button>
<button class="primary" onclick="preview()">👁 Vista previa</button>
</div>
</header>

<div class="layout">
<section class="stage">
<div class="map" id="map">
<img src="data:image/png;base64," alt="Mapa original">
</div>
<div class="note">Las zonas interactivas son <b>transparentes</b>. En modo edición se muestran apenas con un borde al seleccionarlas; en la vista previa desaparecen por completo y se puede hacer clic directamente sobre los íconos del mapa.</div>
</section>

<aside class="panel">
<div id="editor"><div class="note"><b>Seleccioná una zona</b><br>Podés crear una zona transparente y colocarla exactamente sobre un ícono existente.</div></div>
<div class="list"><b style="font-size:13px">Zonas cargadas</b><div id="list"></div></div>
</aside>
</div>

<script>
const KEY='mapa_transparente_quilmes_v2';
let points=JSON.parse(localStorage.getItem(KEY)||"[{\"id\": \"p1\", \"x\": 58, \"y\": 43, \"name\": \"Nuevo punto\", \"description\": \"\", \"address\": \"\", \"materials\": \"\", \"image\": \"\", \"video\": \"\", \"link\": \"\", \"w\": 5, \"h\": 7}]");
let selected=null, editMode=true, imageData='';
const map=document.getElementById('map');

function save(){localStorage.setItem(KEY,JSON.stringify(points));}
function esc(s){return String(s||'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[m]));}
function attr(s){return esc(s).replace(/`/g,'&#096;');}
function uid(){return 'p'+Date.now()+Math.random().toString(16).slice(2);}

function render(){
 map.querySelectorAll('.hotspot,.preview').forEach(x=>x.remove());
 points.forEach(p=>{
   const b=document.createElement('button');
   b.className='hotspot'+(selected===p.id?' selected':'');
   b.style.left=p.x+'%';b.style.top=p.y+'%';
   b.style.width=p.w+'%';b.style.height=p.h+'%';
   b.title=editMode?(p.name||'Zona transparente'):'';
   b.onclick=e=>{e.stopPropagation(); if(editMode) select(p.id); else showPreview(p,b);};
   drag(b,p); map.appendChild(b);
 });
 renderEditor(); renderList();
}

function select(id){selected=id;editMode=true;render();}

function renderEditor(){
 const e=document.getElementById('editor'),p=points.find(x=>x.id===selected);
 if(!p){e.innerHTML='<div class="note"><b>Seleccioná una zona</b><br>Creá una zona transparente y ubicála sobre un ícono del mapa.</div>';return;}
 e.innerHTML=`
 <h2>Editar zona transparente</h2>
 <label>Nombre</label><input id="name" value="${attr(p.name)}">
 <label>Descripción</label><textarea id="desc">${esc(p.description)}</textarea>
 <label>Dirección / ubicación</label><input id="address" value="${attr(p.address)}">
 <label>Información / materiales</label><input id="materials" value="${attr(p.materials)}">
 <label>Imagen</label><input id="image" type="file" accept="image/*">
 <label>Video (URL)</label><input id="video" value="${attr(p.video)}" placeholder="https://youtube.com/...">
 <label>Link “Ver más”</label><input id="link" value="${attr(p.link)}" placeholder="https://...">
 <div class="row"><button class="primary" onclick="update()">Guardar</button><button class="danger" onclick="del()">Eliminar</button></div>
 <div class="note">Posición: ${p.x.toFixed(1)}% / ${p.y.toFixed(1)}% · Tamaño de zona: ${p.w.toFixed(1)}% × ${p.h.toFixed(1)}%</div>`;
 document.getElementById('image').onchange=e=>{
   const f=e.target.files[0];if(!f)return;const r=new FileReader();r.onload=()=>imageData=r.result;r.readAsDataURL(f);
 };
}

function update(){
 const p=points.find(x=>x.id===selected);if(!p)return;
 p.name=document.getElementById('name').value;p.description=document.getElementById('desc').value;
 p.address=document.getElementById('address').value;p.materials=document.getElementById('materials').value;
 p.video=document.getElementById('video').value;p.link=document.getElementById('link').value;
 if(imageData){p.image=imageData;imageData='';}
 save();render();
}

function addPoint(){
 const p={id:uid(),x:50,y:50,w:6,h:7,name:'Nuevo punto',description:'',address:'',materials:'',image:'',video:'',link:''};
 points.push(p);selected=p.id;save();render();
}

function del(){
 if(confirm('¿Eliminar esta zona transparente?')){points=points.filter(x=>x.id!==selected);selected=null;save();render();}
}

function drag(el,p){
 let moving=false, moved=false;
 el.onpointerdown=e=>{e.preventDefault();e.stopPropagation();moving=true;moved=false;el.setPointerCapture(e.pointerId);};
 el.onpointermove=e=>{
  if(!moving)return;moved=true;const r=map.getBoundingClientRect();
  p.x=Math.max(0.5,Math.min(99.5,(e.clientX-r.left)/r.width*100));
  p.y=Math.max(0.5,Math.min(99.5,(e.clientY-r.top)/r.height*100));
  el.style.left=p.x+'%';el.style.top=p.y+'%';
 };
 el.onpointerup=e=>{if(!moving)return;moving=false;if(moved){save();if(selected===p.id)renderEditor();}};
}

function renderList(){
 const l=document.getElementById('list');l.innerHTML='';
 points.forEach((p,i)=>{const d=document.createElement('div');d.className='item';d.textContent=(i+1)+'. '+(p.name||'Sin nombre');d.onclick=()=>select(p.id);l.appendChild(d);});
}

function preview(){
 editMode=false;selected=null;
 map.querySelectorAll('.hotspot').forEach(b=>{b.classList.remove('selected');b.style.background='transparent';b.style.border='1px solid transparent';});
 render();
 alert('Vista previa: los botones son totalmente transparentes. Hacé clic sobre los íconos del mapa. Para volver a editar, presioná F5/recargá la página.');
}

function showPreview(p,b){
 map.querySelectorAll('.preview').forEach(x=>x.remove());
 const c=document.createElement('div');c.className='preview show';
 c.innerHTML=`<button style="float:right;border:0;border-radius:50%;width:25px;height:25px" onclick="this.parentElement.remove()">×</button>
 <h3>${esc(p.name)}</h3><p>${esc(p.description)}</p>
 ${p.address?'<p>📍 '+esc(p.address)+'</p>':''}
 ${p.materials?'<p>♻️ '+esc(p.materials)+'</p>':''}
 ${p.image?'<img src="'+p.image+'">':''}
 ${p.video?'<p>🎥 <a href="'+attr(p.video)+'" target="_blank">Ver video</a></p>':''}
 ${p.link?'<p><a href="'+attr(p.link)+'" target="_blank">Ver más →</a></p>':''}`;
 map.appendChild(c);
 const r=map.getBoundingClientRect(),q=b.getBoundingClientRect();
 let left=q.left-r.left+15,top=q.top-r.top+15;
 if(left+280>r.width)left=q.left-r.left-295;if(top+220>r.height)top=Math.max(10,q.top-r.top-220);
 c.style.left=left+'px';c.style.top=top+'px';
}

function exportData(){
 const blob=new Blob([JSON.stringify(points,null,2)],{type:'application/json'});
 const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='mapa-quilmes-puntos.json';a.click();
}
function importData(){
 const i=document.createElement('input');i.type='file';i.accept='.json';
 i.onchange=()=>{const r=new FileReader();r.onload=()=>{try{points=JSON.parse(r.result);selected=null;editMode=true;save();render();}catch(e){alert('Archivo inválido');}};r.readAsText(i.files[0]);};i.click();
}
map.onclick=()=>{if(editMode){selected=null;render();}};
render();
</script>
</body>
</html>
